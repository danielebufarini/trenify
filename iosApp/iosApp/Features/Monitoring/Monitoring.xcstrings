    "mon.bestEffort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoring runs on this device only and stops when the app cannot refresh. No continuous background guarantee."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il monitoraggio avviene solo su questo dispositivo e si interrompe quando l’app non può aggiornare. Nessuna garanzia di continuità in background."
          }
        }
      }
    },
