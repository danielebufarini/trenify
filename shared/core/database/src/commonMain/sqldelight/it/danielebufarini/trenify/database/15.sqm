-- T7.15 closure: installation notification preferences live in app_metadata
-- (see AppMetadata.sq), but no earlier migration created the table, so
-- databases upgraded from any historical version lack it and settings
-- reads/writes fail with "no such table". Create it for migrated databases;
-- fresh installs already create it from the current schema. IF NOT EXISTS
-- keeps the step idempotent.
CREATE TABLE IF NOT EXISTS app_metadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);
